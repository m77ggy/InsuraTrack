# ------------------------------------------------------------
# InsuraTrack configuration. Copy this file to ".env" and edit.
# With everything left as "console", the app runs in SIMULATED
# mode: messages are logged and shown in the app, nothing is sent.
# ------------------------------------------------------------
PORT=3000

# Secret used to sign login tokens. If empty, one is generated and
# stored in data/.jwt_secret automatically.
JWT_SECRET=

# If set, people registering as a CTPL Agent must enter this code.
AGENT_SIGNUP_CODE=

# ---------- EMAIL ----------
# console | brevo | resend
EMAIL_PROVIDER=console
# Must be a sender you verified with the provider.
EMAIL_FROM=
EMAIL_FROM_NAME=InsuraTrack
BREVO_API_KEY=
RESEND_API_KEY=

# ---------- SMS ----------
# console | semaphore
SMS_PROVIDER=console
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=

# ---------- REMINDER ENGINE ----------
# Days before the CTPL expiry date when a reminder is sent.
REMINDER_DAYS=60,30,15,10,5
# Automatic reminders are only sent between these hours (Asia/Manila, 24h).
SEND_WINDOW=8-20

# Public HTTPS address of your deployed site. Reminder emails load /logo.png from it.
# Localhost addresses cannot be loaded by recipients' email clients.
PUBLIC_BASE_URL=
# Optional: override with a publicly accessible HTTPS image URL (e.g. your CDN).
EMAIL_LOGO_URL=
